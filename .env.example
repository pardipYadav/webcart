# Public site address. The cart QR code points here.
# Use the production domain before you print the QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas. Orders are saved here even if WhatsApp fails.
# Leave blank in local development to store orders in web/data/orders.json.
MONGODB_URI=
MONGODB_DB=traverso

# Number that receives order messages, with country code and no plus sign.
# Example for India: 9198XXXXXXXX
WHATSAPP_OWNER_NUMBER=

# WhatsApp Business Platform (Cloud API). Leave blank to use the manual
# "Send order on WhatsApp" button instead of an automatic message.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional approved template. When set, the first order message uses this
# template with 12 body variables: order id, status, name, mobile, product,
# quantity, ingredients, instructions, total, date, time, verify link.
# When blank, a plain text message is sent (that only delivers inside an open
# 24-hour customer-care window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Google Pay / UPI account shown at checkout. Example: name@okaxis
# You can also paste the UPI ID in web/src/config/payment.ts.
UPI_ID=
UPI_PAYEE_NAME=Traverso

# Razorpay verifies Google Pay before an order is confirmed.
# Leave these blank and checkout stays Pending Payment.
# RAZORPAY_KEY_ID is the Key Id. RAZORPAY_KEY_SECRET stays on the server.
# Point a Razorpay webhook at /api/razorpay/webhook for payment.captured,
# and put that webhook secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Key for /desk, where you mark a payment as confirmed. At least 8 characters.
OWNER_KEY=

# Cart hours in Asia/Kolkata. 24-hour HH:MM. Close time is included.
CART_OPEN_TIME=07:00
CART_CLOSE_TIME=11:30
CART_PREP_MINUTES=15

# Emergency switches. Leave both false (or unset) in production.
CART_FORCE_OPEN=false
CART_FORCE_CLOSED=false
