# Public site address. The cart QR code points here.
# Use the production domain before you print the QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas. Orders are saved here even if WhatsApp fails.
# Leave blank in local development to store orders in web/data/orders.json.
MONGODB_URI=
MONGODB_DB=traverso

# Number that receives order messages, with country code and no plus sign.
# Example for India: 9198XXXXXXXX
WHATSAPP_OWNER_NUMBER=

# WhatsApp Business Platform (Cloud API). Leave blank to use the manual
# "Send order on WhatsApp" button instead of an automatic message.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional approved template. When set, orders are sent as this template
# with 9 body variables: order id, name, mobile, product, ingredients,
# instructions, date, time, pickup. When blank, a plain text message is sent
# (that only delivers inside an open 24-hour customer-care window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Cart hours in Asia/Kolkata. 24-hour HH:MM. Close time is included.
CART_OPEN_TIME=07:00
CART_CLOSE_TIME=11:30
CART_PREP_MINUTES=15

# Emergency switches. Leave both false (or unset) in production.
CART_FORCE_OPEN=false
CART_FORCE_CLOSED=false
